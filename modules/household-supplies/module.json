{
  "manifestVersion": 1,
  "id": "household-supplies",
  "name": "Household supplies",
  "version": "0.2.0",
  "description": "Household consumables on their own page, built on the pantry: grouped by product, minimum and target per product, one-tap -1, a Running low dashboard widget.",
  "entry": "index.js",
  "style": "style.css",
  "icon": "package",
  "accent": "#0EA5E9",
  "i18n": { "defaultLocale": "en" },
  "menu": {
    "show": true,
    "label": "Supplies",
    "labelKey": "menu",
    "icon": "package",
    "order": 60
  },
  "page": {
    "composition": "reading"
  },
  "capabilities": {
    "permissions": {
      "module": { "label": "Household supplies", "labelKey": "module", "icon": "package" },
      "widgets": [{ "id": "low-stock", "label": "Running low", "labelKey": "widgets.low_stock" }]
    },
    "widgets": [{
      "id": "low-stock",
      "entry": "widgets/low-stock.js",
      "label": "Running low",
      "labelKey": "widgets.low_stock",
      "icon": "package",
      "defaultSize": "1x2",
      "defaultVisible": false,
      "optionsSchema": {
        "household_categories": {
          "type": "string",
          "title": "Household categories (comma separated)",
          "titleKey": "options.household_categories",
          "default": "Haushalt, Drogerie"
        },
        "view": {
          "type": "string",
          "enum": ["household", "food", "all"],
          "title": "Show",
          "titleKey": "options.view",
          "default": "household"
        }
      }
    }]
  }
}
